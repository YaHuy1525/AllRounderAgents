{
  "name": "allrounder-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/approval-ui"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/dev.mjs backend",
    "dev:frontend": "node scripts/dev.mjs frontend",
    "dev:mastra": "mastra dev --dir src/mastra",
    "studio": "mastra studio",
    "lint": "tsc -p tsconfig.json --noEmit && npm run lint -w @allrounder/approval-ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && npm run typecheck -w @allrounder/approval-ui",
    "test": "vitest run && npm run test -w @allrounder/approval-ui",
    "test:coverage": "vitest run --coverage",
    "eval:seed": "node --env-file=.env scripts/seed-mastra-datasets.mjs",
    "eval:run": "node scripts/run-coding-eval.mjs",
    "eval:coding-quality": "node --experimental-strip-types scripts/run-coding-quality-eval.mjs",
    "build": "npm run build --workspaces --if-present"
  },
  "dependencies": {
    "@mastra/agent-browser": "^0.5.3",
    "@mastra/core": "^1.76.0",
    "@mastra/docker": "^0.10.0",
    "@mastra/e2b": "^0.13.0",
    "@mastra/evals": "^1.10.6",
    "@mastra/mcp": "^2.3.0",
    "@mastra/memory": "^1.30.0",
    "@mastra/observability": "^1.18.4",
    "@mastra/pg": "^1.25.0",
    "@mastra/rag": "^2.6.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.4",
    "jose": "^6.2.13",
    "mastra": "^1.27.3",
    "supabase": "^2.116.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
