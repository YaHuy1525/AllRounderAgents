# Secrets and local configuration
.env
.env.*
!.env.example

# JavaScript / TypeScript
node_modules/
dist/
coverage/
*.tsbuildinfo

# Next.js build output (approval UI)
.next/
apps/approval-ui/out/

# Mastra generated artifacts (keep .mastra/bundler-config.mjs tracked)
.mastra/output/
.mastra/.build/
.mastra/dev.lock
.mastra/mastra-packages.json

# Embedded DuckDB observability store (dev metrics, see src/mastra/mastra.ts)
mastra*.duckdb
mastra*.duckdb.wal

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
tmp/
temp/

# Supabase local-only state
supabase/.branches/
supabase/.temp/
/docs
.mastra
.qoder/
/fixtures

# QA lane: a Playwright storage-state file holds a live session cookie, so it
# stays local; it is produced once by a human login. See the qa agent squad plan.
/.qa/

# Judge eval harness: generated reports and judgment cache stay local;
# candidates and baselines are committed.
evals/judge/.cache/
evals/judge/reports/
system_design
# SDD scratch: ledgers, briefs, review packages stay local
.superpowers/
