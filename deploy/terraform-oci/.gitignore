# Terraform state holds resource identifiers and, depending on the backend,
# secret material. It is never committed for a personal free-tier project.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log

# Real credentials.
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars

# The node private key generated by tls_private_key in main.tf.
keys/
