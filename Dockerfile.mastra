# Container for the Mastra host (all workflows + agents).
# Built by CD as ghcr.io/<owner>/allrounderagent-mastra:sha-<short>.

# ---------- Stage 1: build the bundle ----------
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Root manifest + lockfile. The approval-ui workspace manifest is copied only so
# the lockfile's workspace references resolve; --workspaces=false skips installing
# its (large) dependency tree.
COPY package.json package-lock.json ./
COPY apps/approval-ui/package.json ./apps/approval-ui/package.json

# Peer deps are not auto-installed (see .npmrc), so `ci` must run with the same
# flag. The .npmrc is not copied into the image, and a bare `npm ci` would
# demand the dropped peer entries (nested zod, @atlaskit's react@18) and report
# the lock out of sync. The installer is pinned to one npm major in both stages
# so a build here matches a fresh `npm ci` on any machine of the same npm line.
RUN npm install --global npm@11

RUN npm ci --workspaces=false --legacy-peer-deps

COPY tsconfig.json ./
COPY src ./src

# mastra build does two things: it bundles, then it runs a fresh `npm install`
# of the bundle's externalised dependencies inside .mastra/output. That second
# install does NOT read the repo .npmrc (deliberately not copied here), so it
# resolves peers strictly and aborts when @mastra/mcp@2.5.0's `zod@^4.2.0` peer
# meets this project's `zod@^3.25` pin. npm honours the same policy through the
# environment, so the deployer's install gets the flag the app's own `npm ci`
# already uses. Platform-independent: without it the amd64 image fails too.
ENV NPM_CONFIG_LEGACY_PEER_DEPS=true

RUN npx --no-install mastra build --dir src/mastra

# ---------- Stage 2: runtime ----------
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=4111 \
    MASTRA_HOST=0.0.0.0

WORKDIR /app

# Production dependencies only (the bundle resolves @mastra/* from node_modules).
COPY package.json package-lock.json ./
RUN npm install --global npm@11
RUN npm ci --workspaces=false --omit=dev --legacy-peer-deps && npm cache clean --force

# Layout trick (Gotcha 2): the bundle resolves `fixtures/` three levels up from
# `.mastra/output`, so the server lives at /app/svc and fixtures at /app/fixtures.
COPY --from=builder /app/.mastra/output ./svc/.mastra/output
COPY fixtures ./fixtures

# The observability DuckDB store opens `mastra.duckdb` in the working directory,
# so /app/svc (created root-owned by WORKDIR and the stage-copy) must be
# writable by the runtime user.
RUN chown -R node:node /app/svc

USER node

WORKDIR /app/svc

EXPOSE 4111

CMD ["node", ".mastra/output/index.mjs"]
