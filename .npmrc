# mdast-util-from-adf depends on @atlaskit/adf-schema, whose peer chain pins
# react@^18 and collides with this workspace's react@19. The @atlaskit tree is
# only needed for ADF type definitions (never executed), so peers are not
# auto-installed. Keep local installs consistent with package-lock.json,
# which was generated with this flag.
legacy-peer-deps=true
