# =============================================================================
# BACKEND ONLY — never expose these values to browser bundles or client logs.
# =============================================================================
# Use Supabase's connection pooler (Supavisor) string for server persistence.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

WEBHOOK_SECRET=replace-with-jira-webhook-signing-secret
APPROVAL_HMAC_SECRET=replace-with-at-least-32-random-bytes
REDIS_URL=redis://localhost:6379/0
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
TRUSTED_PROXY_IPS=[]
RATE_LIMIT_PER_MINUTE=120
# Window length (seconds) shared by the in-process and Redis limiters, plus
# the LRU cap on tracked client keys for the in-process limiter (Redis keys
# expire with the window; 429 responses mirror the configured window in
# Retry-After).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_TRACKED_KEYS=10000
# Optional governance policy override (risk.yaml + tools.yaml). Unset, the
# loader walks up from the API package and finds the repo-root `policy/`.
POLICY_DIR=

# Ops stack (compose): Grafana admin login for the provisioned Prometheus
# datasource + dashboards (Grafana http://localhost:3001, Prometheus :9090).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=ENG
# The default project key must appear in this tenant-to-project map.
JIRA_TENANT_PROJECT_ALLOWLIST={"tenant-a":["ENG"]}
JIRA_EMAIL=automation@example.com
# For JIRA_TRANSPORT=mcp this token needs the Rovo agent-interface scopes
# read:jira:agent-interface, search:jira:agent-interface and
# write:jira:agent-interface (select them when creating the token at
# id.atlassian.com/manage-profile/security/api-tokens); classic REST-only
# tokens are rejected by the MCP server. It remains a valid REST token.
JIRA_API_TOKEN=replace-with-jira-api-token
# Backend selection for Jira writes + issue search: "mcp" routes comments,
# transitions and JQL search through the Atlassian Rovo MCP server (default);
# "http" keeps the legacy REST transport. Board listing always uses read-only
# REST GETs (Rovo has no agile-board tools). For "mcp", the org admin must
# enable API-token connections for the Rovo MCP server on the Atlassian site
# (admin.atlassian.com → Rovo → Rovo MCP server → Authentication).
JIRA_TRANSPORT=mcp
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp
# Optional cloudId (site UUID) for Rovo calls; when empty the site URL
# (JIRA_BASE_URL) is sent and the server resolves it.
JIRA_CLOUD_ID=

# MSP lane (mspFlow): replies leave from the mailbox named by MAIL_FROM. When
# MAIL_OUTBOX_DIR is set the outbox sender writes one .eml per reply into that
# directory (the sandbox mailbox); unset, mspFlow keeps the in-memory mailbox.
MAIL_OUTBOX_DIR=
MAIL_FROM=service-desk@msp.local

# MSP knowledge seam: the Mastra host grounds each reply draft through the
# API's POST /knowledge/search with this shared bearer token. The API mounts
# the route only when the token is set (and the model embeddings are
# configured); the host calls it at KNOWLEDGE_API_URL (compose overrides that
# with http://api:8000). Unset, drafts carry no retrieval and every draft
# escalates for a human edit. Generate one with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
KNOWLEDGE_SERVICE_TOKEN=
KNOWLEDGE_API_URL=http://localhost:8000

# MSP desk alternative (mspFlow): with HALO_BASE_URL, HALO_CLIENT_ID and
# HALO_CLIENT_SECRET set (and the JIRA_* desk unset, since Jira wins when
# both are configured), the lane files tickets on HaloPSA instead of Jira.
# Create the credentials under Configuration > Integrations > Halo API with
# the client-credentials method. HALO_TENANT names a hosted tenant (sent as
# ?tenant= on the token request), HALO_TICKET_TYPE_ID is the default ticket
# type, and HALO_CLIENT_IDS maps case refs to Halo company ids
# ({"acme":42}); HALO_DEFAULT_CLIENT_ID covers refs without a mapping.
# Unset, the in-memory desk keeps the sandbox honest.
HALO_BASE_URL=
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=
HALO_TENANT=
HALO_SCOPE=all
HALO_TICKET_TYPE_ID=
HALO_CLIENT_IDS=
HALO_DEFAULT_CLIENT_ID=

# Bills lane (billsFlow): posting goes to the Xero ledger only when
# XERO_CLIENT_ID, XERO_CLIENT_SECRET and XERO_TENANT_ID are all set (a Xero
# custom connection with the accounting.transactions scope; Xero shows the
# tenant id after the first authorize). XERO_ACCOUNT_CODE optionally stamps
# every posted line. Unset, the lane keeps the in-memory ledger, so the flow,
# receipts and tests run without Xero. The vendor registry reuses
# KNOWLEDGE_API_URL and KNOWLEDGE_SERVICE_TOKEN above to call the API's
# POST /msp/vendors/lookup, so senders are only matched when that pair is
# set; otherwise every bill escalates as vendor_unverified.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
XERO_ACCOUNT_CODE=

MODEL_PROVIDER=openai
MODEL_NAME=replace-with-model-name
MODEL_API_KEY=replace-with-model-provider-key
MODEL_BASE_URL=https://api.openai.com/v1
# Mastra agents run through the model router on OpenRouter.
# Set this for `openrouter/deepseek/deepseek-v4-flash` (never expose it to the browser).
OPENROUTER_API_KEY=replace-with-openrouter-api-key
EMBEDDING_MODEL=replace-with-pinned-embedding-model
EMBEDDING_DIMENSIONS=1536
# Optional separate embeddings provider (OpenAI-compatible /embeddings), e.g.
# the Cohere compatibility endpoint at https://api.cohere.ai/compatibility/v1.
# Unset, the MODEL_* block serves embeddings too.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Knowledge retrieval tuning: RRF smoothing (RETRIEVAL_RRF_K), candidates per
# arm before reranking (RETRIEVAL_RECALL_K), the Cohere reranker model used
# when a reranker is configured (RETRIEVAL_RERANK_MODEL), and optional per
# tenant overrides as JSON, e.g. {"tenant-a":{"recall_k":50}}.
RETRIEVAL_RRF_K=60
RETRIEVAL_RECALL_K=30
RETRIEVAL_RERANK_MODEL=rerank-v3.5
RETRIEVAL_TENANT_OVERRIDES={}

# Preferred: mint short-lived installation tokens from a GitHub App in the backend.
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678
# Preserve PEM newlines as \n when your secret manager requires one line.
GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----
# Runtime token seam: a short-lived App installation token, or fine-grained PAT fallback.
GITHUB_TOKEN=github_pat_replace-me
# Coding-agent GitHub backend: "mcp" (default) talks to the official GitHub MCP
# server (https://api.githubcopilot.com/mcp/) with the PAT below as a bearer
# token; "rest" keeps the legacy api.github.com transport with GITHUB_TOKEN.
# MCP connectivity check: node scripts/github-mcp-verify.mjs
GITHUB_ACCESS=mcp
GITHUB_MCP_TOKEN=github_pat_replace-me
# PR-review flow (reviewFlow) always reads/writes reviews over the REST API
# with GITHUB_TOKEN. GITHUB_REPOSITORY_ALLOWLIST is the guaranteed floor and
# the flow-registration switch: at startup the host also discovers every
# repository the token can see (up to five pages), so runs are not limited to
# this list.
GITHUB_REPOSITORY_ALLOWLIST=["owner/repository"]
GITHUB_BASE_BRANCH=main
# The Dependency Update lane reads the root manifest + lockfile, so keep the
# package manifest paths in the allowlist or its scan fails with path_denied.
GITHUB_PATH_ALLOWLIST=["src/**","tests/**","config/**","docs/**","package.json","package-lock.json"]
GITHUB_PATH_DENYLIST=[".github/workflows/**","infra/prod/**"]
GITHUB_DESTRUCTIVE_PATHS=["migrations/**","infra/**"]
GITHUB_MAX_PATCH_FILES=10
GITHUB_MAX_PATCH_BYTES=250000
GITHUB_REQUEST_TIMEOUT_SECONDS=10

# The runs engine bridges to the Mastra server (`npm run dev:mastra`, default
# http://localhost:4111). When the API runs in Docker and Mastra on the host,
# point it at host.docker.internal. Compose overrides this for its api service
# with http://mastra:4111, so the bundled stack needs no host Mastra process.
MASTRA_BASE_URL=http://host.docker.internal:4111
# Upper bound (seconds, settings cap 600) for a single Mastra start/resume
# pass; heavy LLM steps (engineer regenerate plus repairs) exceed the 60s
# default. The Mastra server raises its own 504 ceiling to the same value.
MASTRA_REQUEST_TIMEOUT_SECONDS=600
# Mastra storage backend: whenever DATABASE_URL above is set, workflows and
# the security case index persist in Postgres (@mastra/pg) so suspended runs
# survive host restarts; without it everything stays in-memory per process.
# MASTRA_PG_SSL forces Postgres TLS on ("true") or off ("false"); unset,
# localhost stays plaintext and every other host uses TLS.
MASTRA_PG_SSL=
# Optional embedder (e.g. openai/text-embedding-3-small) enabling semantic
# recall over past security dispositions; unset keeps message-history recall.
MASTRA_MEMORY_EMBEDDER=

# Judge eval harness (scripts/judge-eval.py). The judge of record is TypeSafe
# System One (Jev); JEV_API_KEY unset makes `--judge auto` skip with exit 0, so
# forks stay green. The chat judge (OpenAI-compatible) is the fallback judge and
# the failure explainer.
JUDGE_PROVIDER=jev
JUDGE_MODEL=jev-latest
JEV_API_KEY=
JUDGE_CHAT_BASE_URL=https://openrouter.ai/api/v1
JUDGE_CHAT_MODEL=
JUDGE_CHAT_API_KEY=
JUDGE_TIMEOUT_SECONDS=60
# Produce auth for scripts/judge-eval.py. Preferred: a ready bearer token;
# otherwise mint one via the Supabase password grant with the email/password
# pair (SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are reused when the
# JUDGE_EVAL_* overrides are empty).
JUDGE_EVAL_TOKEN=
JUDGE_EVAL_EMAIL=
JUDGE_EVAL_PASSWORD=
JUDGE_EVAL_SUPABASE_URL=
JUDGE_EVAL_SUPABASE_ANON_KEY=

# =============================================================================
# BROWSER SAFE — only the Supabase URL and publishable/anon key belong here.
# Never copy SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL into a browser variable.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key

# Browser variables used by apps/approval-ui. These three values are browser-safe.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
VITE_API_URL=http://localhost:8000
