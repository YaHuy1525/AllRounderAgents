# =============================================================================
# BACKEND ONLY — never expose these values to browser bundles or client logs.
# =============================================================================
# Use Supabase's direct Postgres connection string for server persistence.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

WEBHOOK_SECRET=replace-with-jira-webhook-signing-secret
APPROVAL_HMAC_SECRET=replace-with-at-least-32-random-bytes
REDIS_URL=redis://localhost:6379/0
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
TRUSTED_PROXY_IPS=[]
RATE_LIMIT_PER_MINUTE=120

# Ops stack (compose): Grafana admin login for the provisioned Prometheus
# datasource + dashboards (Grafana http://localhost:3001, Prometheus :9090).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=ENG
# The default project key must appear in this tenant-to-project map.
JIRA_TENANT_PROJECT_ALLOWLIST={"tenant-a":["ENG"]}
JIRA_EMAIL=automation@example.com
# For JIRA_TRANSPORT=mcp this token needs the Rovo agent-interface scopes
# read:jira:agent-interface, search:jira:agent-interface and
# write:jira:agent-interface (select them when creating the token at
# id.atlassian.com/manage-profile/security/api-tokens); classic REST-only
# tokens are rejected by the MCP server. It remains a valid REST token.
JIRA_API_TOKEN=replace-with-jira-api-token
# Backend selection for Jira writes + issue search: "mcp" routes comments,
# transitions and JQL search through the Atlassian Rovo MCP server (default);
# "http" keeps the legacy REST transport. Board listing always uses read-only
# REST GETs (Rovo has no agile-board tools). For "mcp", the org admin must
# enable API-token connections for the Rovo MCP server on the Atlassian site
# (admin.atlassian.com → Rovo → Rovo MCP server → Authentication).
JIRA_TRANSPORT=mcp
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp
# Optional cloudId (site UUID) for Rovo calls; when empty the site URL
# (JIRA_BASE_URL) is sent and the server resolves it.
JIRA_CLOUD_ID=

MODEL_PROVIDER=openai
MODEL_NAME=replace-with-model-name
MODEL_API_KEY=replace-with-model-provider-key
MODEL_BASE_URL=https://api.openai.com/v1
# Mastra agents use DeepSeek v4 flash via the model router.
# Set this for `deepseek/deepseek-v4-flash` (never expose it to the browser).
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
EMBEDDING_MODEL=replace-with-pinned-embedding-model
EMBEDDING_DIMENSIONS=1536

# Preferred: mint short-lived installation tokens from a GitHub App in the backend.
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678
# Preserve PEM newlines as \n when your secret manager requires one line.
GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----
# Runtime token seam: a short-lived App installation token, or fine-grained PAT fallback.
GITHUB_TOKEN=github_pat_replace-me
# Coding-agent GitHub backend: "mcp" (default) talks to the official GitHub MCP
# server (https://api.githubcopilot.com/mcp/) with the PAT below as a bearer
# token; "rest" keeps the legacy api.github.com transport with GITHUB_TOKEN.
# MCP connectivity check: node scripts/github-mcp-verify.mjs
GITHUB_ACCESS=mcp
GITHUB_MCP_TOKEN=github_pat_replace-me
GITHUB_REPOSITORY_ALLOWLIST=["owner/repository"]
GITHUB_BASE_BRANCH=main
GITHUB_PATH_ALLOWLIST=["src/**","tests/**","config/**","docs/**"]
GITHUB_PATH_DENYLIST=[".github/workflows/**","infra/prod/**"]
GITHUB_DESTRUCTIVE_PATHS=["migrations/**","infra/**"]
GITHUB_MAX_PATCH_FILES=10
GITHUB_MAX_PATCH_BYTES=250000
GITHUB_REQUEST_TIMEOUT_SECONDS=10

# =============================================================================
# BROWSER SAFE — only the Supabase URL and publishable/anon key belong here.
# Never copy SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL into a browser variable.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key

# Browser variables used by apps/approval-ui. These three values are browser-safe.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
VITE_API_URL=http://localhost:8000
